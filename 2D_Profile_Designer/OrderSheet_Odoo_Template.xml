<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Define the report template -->
        <template id="report_order_sheet_document">
            <t t-call="web.html_container">
                <t t-set="body_classname" t-value="'container'"/>
                <t t-call="web.report_layout">
                    <div class="page">
                        <style>
                            /* Order Sheet Styles */
                            #printSheetSection {
                                font-family: Arial, sans-serif;
                                font-size: 12px;
                                line-height: 1.2;
                                background: white;
                                width: 100%;
                                padding: 15px;
                                margin: 0 auto;
                                box-sizing: border-box;
                            }

                            #printSheetSection * {
                                box-sizing: border-box;
                            }

                            /* Data containers */
                            .data-field {
                                display: inline-block;
                                min-width: 120px;
                                padding: 2px 6px;
                                border-bottom: 1px solid #333;
                                font-weight: normal;
                                background: transparent;
                                font-size: 12px;
                            }

                            .data-field.wide {
                                min-width: 250px;
                            }

                            .data-field.compact {
                                min-width: 150px;
                            }

                            .data-field.full {
                                width: 100%;
                            }

                            /* Header Section */
                            .header {
                                position: relative;
                                display: flex;
                                justify-content: space-between;
                                align-items: center;
                                margin-bottom: 10px;
                                border-bottom: 2px solid black;
                                padding: 8px 15px;
                            }

                            .logo-section {
                                display: flex;
                                align-items: center;
                            }

                            .logo-box {
                                width: 100px;
                                height: 65px;
                                background-color: #2c5f5f;
                                color: white;
                                display: flex;
                                flex-direction: column;
                                justify-content: center;
                                align-items: center;
                                font-weight: bold;
                            }

                            .logo-text {
                                font-size: 16px;
                                margin-bottom: 2px;
                            }

                            .dots {
                                display: flex;
                                gap: 1px;
                                margin-bottom: 2px;
                            }

                            .dot {
                                width: 6px;
                                height: 6px;
                                background-color: white;
                                border-radius: 50%;
                            }

                            .metalworks {
                                font-size: 10px;
                                letter-spacing: 1px;
                            }

                            .title-section {
                                position: absolute;
                                left: 50%;
                                transform: translateX(-50%);
                                top: 8px;
                                text-align: center;
                            }

                            .order-sheet-title {
                                font-size: 28px;
                                font-weight: bold;
                                margin: 0 6px 3px;
                            }

                            .dates-section {
                                text-align: left;
                                min-width: 240px;
                            }

                            .date-row {
                                margin-bottom: 5px;
                                display: flex;
                                align-items: center;
                            }

                            .date-label {
                                font-size: 12px;
                                font-weight: bold;
                                width: 90px;
                                display: inline-block;
                            }

                            /* Content Sections */
                            .section {
                                margin: 4px 0;
                                padding: 5px 15px;
                            }

                            .section.bordered {
                                border-bottom: 1px solid #333;
                                padding-bottom: 5px;
                            }

                            .row {
                                display: flex;
                                gap: 20px;
                                margin-bottom: 8px;
                                align-items: flex-start;
                            }

                            .col {
                                flex: 1;
                                padding: 0 10px;
                            }

                            .col.narrow {
                                flex: 0.8;
                            }

                            .col.wide {
                                flex: 1.5;
                            }

                            .field-group {
                                margin-bottom: 6px;
                            }

                            .field-label {
                                font-size: 13px;
                                font-weight: bold;
                                margin-bottom: 3px;
                                display: block;
                            }

                            .field-label.inline {
                                display: inline;
                                margin-right: 8px;
                            }

                            /* Material Selection */
                            .material-group {
                                margin-bottom: 8px;
                            }

                            .material-label {
                                font-size: 14px;
                                font-weight: bold;
                                width: 40px;
                                display: inline-block;
                            }

                            .option-group {
                                display: inline-flex;
                                gap: 8px;
                                flex-wrap: wrap;
                            }

                            .option {
                                display: flex;
                                align-items: center;
                                gap: 3px;
                            }

                            .checkbox {
                                width: 14px;
                                height: 14px;
                                border: 2px solid #333;
                                display: inline-block;
                                position: relative;
                            }

                            .checkbox.checked::after {
                                content: '✓';
                                position: absolute;
                                top: -2px;
                                left: 1px;
                                font-size: 12px;
                                font-weight: bold;
                            }

                            .option-label {
                                font-size: 12px;
                                font-weight: bold;
                            }

                            /* Drawing Area */
                            .profile-section {
                                margin: 4px 0 2px 0;
                                padding: 0 15px;
                            }

                            .drawing-area {
                                height: 580px;
                                border: 1px solid #000;
                                margin-top: 8px;
                                position: relative;
                                background: white;
                            }

                            /* Process Status */
                            .process-section {
                                margin-top: 3px;
                            }

                            .process-grid {
                                display: grid;
                                grid-template-columns: repeat(6, 1fr);
                                gap: 4px;
                                margin-top: 2px;
                            }

                            .process-item {
                                display: flex;
                                flex-direction: column;
                                align-items: center;
                                gap: 1px;
                            }

                            .process-checkbox {
                                width: 18px;
                                height: 14px;
                                border: 1px solid #333;
                                position: relative;
                            }

                            .process-checkbox.checked::after {
                                content: '✓';
                                position: absolute;
                                top: -2px;
                                left: 2px;
                                font-size: 12px;
                                font-weight: bold;
                            }

                            .process-label {
                                font-size: 8px;
                                font-weight: bold;
                                text-align: center;
                            }

                            /* Bottom Section */
                            .bottom-grid {
                                display: grid;
                                grid-template-columns: 1fr 1fr 1fr;
                                gap: 6px;
                                margin-top: 6px;
                            }

                            .bottom-field {
                                display: flex;
                                flex-direction: column;
                            }

                            .bottom-label {
                                font-size: 9px;
                                font-weight: bold;
                                margin-bottom: 1px;
                            }
                        </style>

                        <!-- Order Sheet Content -->
                        <div id="printSheetSection">
                            <!-- Header -->
                            <div class="header">
                                <div class="logo-section">
                                    <div class="logo-box">
                                        <div class="logo-text">KYNETIC</div>
                                        <div class="dots">
                                            <div class="dot"></div>
                                            <div class="dot"></div>
                                            <div class="dot"></div>
                                            <div class="dot"></div>
                                            <div class="dot"></div>
                                            <div class="dot"></div>
                                        </div>
                                        <div class="metalworks">metalworks</div>
                                    </div>
                                </div>
                                
                                <div class="title-section">
                                    <div class="order-sheet-title">ORDER SHEET</div>
                                </div>
                                
                                <div class="dates-section">
                                    <div class="date-row">
                                        <span class="date-label">Date Ordered:</span>
                                        <span class="data-field"><t t-esc="o.date_order and o.date_order.strftime('%m/%d/%Y') or ''"/></span>
                                    </div>
                                    <div class="date-row">
                                        <span class="date-label">Completed By:</span>
                                        <span class="data-field"><t t-esc="o.completed_by or ''"/></span>
                                    </div>
                                    <div class="date-row">
                                        <span class="date-label">Date Finished:</span>
                                        <span class="data-field"><t t-esc="o.date_finished and o.date_finished.strftime('%m/%d/%Y') or ''"/></span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Customer & Job Info -->
                            <div class="section bordered">
                                <div class="row">
                                    <div class="col">
                                        <div class="field-group">
                                            <span class="field-label inline">Customer:</span>
                                            <span class="data-field compact"><t t-esc="o.partner_id.name or ''"/></span>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="field-group">
                                            <span class="field-label inline">Job:</span>
                                            <span class="data-field wide"><t t-esc="o.client_order_ref or o.name or ''"/></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Material Selection -->
                            <div class="section bordered">
                                <div class="row">
                                    <div class="col wide">
                                        <div class="material-group">
                                            <span class="material-label">Steel</span>
                                            <div class="option-group">
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'steel' and o.metal_gauge == '22' else ''"></span>
                                                    <span class="option-label">22</span>
                                                </div>
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'steel' and o.metal_gauge == '24' else ''"></span>
                                                    <span class="option-label">24</span>
                                                </div>
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'steel' and o.metal_gauge == '26' else ''"></span>
                                                    <span class="option-label">26</span>
                                                </div>
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'steel' and o.metal_gauge == '28' else ''"></span>
                                                    <span class="option-label">28</span>
                                                </div>
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'steel' and o.metal_gauge == '30' else ''"></span>
                                                    <span class="option-label">30</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="material-group">
                                            <span class="material-label">Al</span>
                                            <div class="option-group">
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'aluminum' and o.metal_gauge == '.019' else ''"></span>
                                                    <span class="option-label">.019</span>
                                                </div>
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'aluminum' and o.metal_gauge == '.027' else ''"></span>
                                                    <span class="option-label">.027</span>
                                                </div>
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'aluminum' and o.metal_gauge == '.032' else ''"></span>
                                                    <span class="option-label">.032</span>
                                                </div>
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'aluminum' and o.metal_gauge == '.040' else ''"></span>
                                                    <span class="option-label">.040</span>
                                                </div>
                                                <div class="option">
                                                    <span class="checkbox" t-att-class="'checked' if o.metal_type == 'aluminum' and o.metal_gauge == '.050' else ''"></span>
                                                    <span class="option-label">.050</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="field-group">
                                            <span class="field-label inline">Color:</span>
                                            <span class="data-field wide"><t t-esc="o.color or ''"/></span>
                                        </div>
                                        
                                        <div class="field-group" style="margin-top: 15px;">
                                            <span class="field-label inline">Color Manufacturer:</span>
                                            <span class="data-field wide"><t t-esc="o.color_manufacturer or ''"/></span>
                                        </div>
                                    </div>
                                    
                                    <div class="col narrow">
                                        <div class="field-group">
                                            <span class="field-label">Quantity:</span>
                                            <span class="data-field"><t t-esc="o.product_uom_qty or '0'"/></span>
                                        </div>
                                        <div class="field-group">
                                            <span class="field-label">Length (inches):</span>
                                            <span class="data-field"><t t-esc="o.length or '0.00'"/></span>
                                        </div>
                                        <div class="field-group">
                                            <span class="field-label">Total Material Usage (inches):</span>
                                            <span class="data-field"><t t-esc="o.material_usage or '0.00'"/></span>
                                        </div>
                                        <div class="field-group">
                                            <span class="checkbox" t-att-class="'checked' if o.has_ribs else ''"></span>
                                            <span class="field-label inline">Include Ribs</span>
                                        </div>
                                        <div class="field-group">
                                            <span class="checkbox" t-att-class="'checked' if o.has_holes else ''"></span>
                                            <span class="field-label inline">Holes</span>
                                        </div>
                                    </div>
                                    
                                    <!-- Hole Details Column (conditionally shown) -->
                                    <div class="col narrow" t-if="o.has_holes">
                                        <div class="field-group">
                                            <span class="field-label">Hole Size (inches):</span>
                                            <span class="data-field compact"><t t-esc="o.hole_size or 'N/A'"/></span>
                                        </div>
                                        <div class="field-group">
                                            <span class="field-label">Hole Spacing (OC):</span>
                                            <span class="data-field compact"><t t-esc="o.hole_spacing or 'N/A'"/></span>
                                        </div>
                                        <div class="field-group">
                                            <span class="field-label">Start From End (OC):</span>
                                            <span class="data-field compact"><t t-esc="o.start_from_end or 'N/A'"/></span>
                                        </div>
                                        <div class="field-group">
                                            <span class="field-label">Distance From Edge (OC):</span>
                                            <span class="data-field compact"><t t-esc="o.distance_from_edge or 'N/A'"/></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Profile Section -->
                            <div class="profile-section">
                                <div class="field-group" style="text-align: center;">
                                    <span class="field-label">Profile Name:</span>
                                    <span class="data-field full"><t t-esc="o.profile_name or o.name or ''"/></span>
                                </div>
                                
                                <div class="drawing-area">
                                    <!-- Profile image would go here if available -->
                                    <t t-if="o.profile_image">
                                        <img t-att-src="'data:image/png;base64,%s' % o.profile_image" style="width: 95%; height: 95%; display: block; margin: 2.5% auto;"/>
                                    </t>
                                </div>
                            </div>
                            
                            <!-- Process Tracking -->
                            <div class="process-section">
                                <div class="process-grid">
                                    <div class="process-item">
                                        <span class="process-label">Slit</span>
                                        <span class="process-checkbox" t-att-class="'checked' if o.process_slit else ''"></span>
                                    </div>
                                    <div class="process-item">
                                        <span class="process-label">Punched</span>
                                        <span class="process-checkbox" t-att-class="'checked' if o.process_punched else ''"></span>
                                    </div>
                                    <div class="process-item">
                                        <span class="process-label">Bent</span>
                                        <span class="process-checkbox" t-att-class="'checked' if o.process_bent else ''"></span>
                                    </div>
                                    <div class="process-item">
                                        <span class="process-label">Packaged</span>
                                        <span class="process-checkbox" t-att-class="'checked' if o.process_packaged else ''"></span>
                                    </div>
                                    <div class="process-item">
                                        <span class="process-label">Shipped</span>
                                        <span class="process-checkbox" t-att-class="'checked' if o.process_shipped else ''"></span>
                                    </div>
                                    <div class="process-item">
                                        <span class="process-label">Invoiced</span>
                                        <span class="process-checkbox" t-att-class="'checked' if o.process_invoiced else ''"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Bottom Fields -->
                            <div class="bottom-grid">
                                <div class="bottom-field">
                                    <span class="bottom-label">Shipping Weight:</span>
                                    <span class="data-field"><t t-esc="o.shipping_weight or ''"/></span>
                                </div>
                                <div class="bottom-field">
                                    <span class="bottom-label">Dimensions:</span>
                                    <span class="data-field"><t t-esc="o.dimensions or ''"/></span>
                                </div>
                                <div class="bottom-field">
                                    <span class="bottom-label">Signature:</span>
                                    <span class="data-field"><t t-esc="o.signature or ''"/></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <!-- Define the report action -->
        <record id="action_report_order_sheet" model="ir.actions.report">
            <field name="name">Order Sheet</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">your_module_name.report_order_sheet_document</field>
            <field name="report_file">your_module_name.report_order_sheet_document</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
